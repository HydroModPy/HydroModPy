<ParametersGroup name="simul">
	<Parameter name="parameterization">
		<description>Uses Parameterization from file first</description>
		<type>bool</type>
		<possible_values>True;False</possible_values> 
		<value/>
		<default_value>True</default_value>
	</Parameter>
	<Parameter name="load">
		<description>Loads the stored watershed files instead of regenerating the code, speeds up the simulation at the expense of some vulnerability</description>
		<type>bool</type>
		<possible_values/>
		<value/>
		<default_value>False</default_value>
	</Parameter>
	<Parameter name="dem">
		<description>Name of Digital Elevation Model</description>
		<type>string</type>
		<possible_values>DEM_test_75m_LAMB93.tif;DEM_bzh_75m_LAMB93.tif</possible_values>
		<value/>
		<default_value>DEM_test_75m_LAMB93.tif</default_value>
	</Parameter>
</ParametersGroup>