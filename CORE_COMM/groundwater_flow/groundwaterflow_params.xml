<ParametersGroup name="groundwaterflow">
	<Parameter name="climatic">
		<description>Constant recharge m/d</description>
		<type>double</type>
		<possible_values/>
		<value/>
		<default_value>8e-4</default_value>
	</Parameter>
	<Parameter name="thick">
		<description>Aquifer Thickness (in meters)</description>
		<type>double</type>
		<possible_values/>
		<value/>
		<default_value>50</default_value>
	</Parameter>
	<Parameter name="time_step">
		<description>time step of integration</description>
		<type>string</type>
		<possible_values/>
		<value/>
		<default_value>daily</default_value>
	</Parameter>
	<Parameter name="model_name">
		<description>name of simulator</description>
		<type>string</type>
		<possible_values>modflow;hs1d</possible_values>
		<value/>
		<default_value>modflow</default_value>
	</Parameter>
	<ParametersGroup name="modflow">
		<Parameter name="modflow_param1">
			<description>parameter of modflow</description>
			<type>string</type>
			<possible_values/>
			<value/>
			<default_value>string_default</default_value>
		</Parameter>
	</ParametersGroup>
	<ParametersGroup name="hs1d">
		<Parameter name="hs1d_param1">
			<description>parameter of hs1d</description>
			<type>string</type>
			<possible_values/>
			<value/>
			<default_value>string_default</default_value>
		</Parameter>
	</ParametersGroup>
</ParametersGroup>
