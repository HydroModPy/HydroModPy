# ======================================================================
# HydroModPy -- example 03 : groundwater_1d analytical calibration
# ======================================================================
# Purely analytical Dupuit-Forchheimer 1D aquifer case. The observations
# are a synthetic noisy head chronicle generated on the fly -- no
# MODFLOW, no filesystem, no network.
#
# Python usage (the canonical entry point for analytic cases):
#
#   from hydromodpy.calibration.cases.groundwater_1d import (
#       build_noisy_groundwater_chronicle,
#       calibrate_groundwater,
#   )
#   chronicle = build_noisy_groundwater_chronicle({ ... [chronicle] ... })
#   result = calibrate_groundwater(
#       method="optuna",
#       chronicle=chronicle,
#       max_iter=50,
#       seed=42,
#       bounds={ "Kam": [1.0, 10.0], ... [calibration.parameters] ... },
#   )
#
# The TOML sections below mirror the kwargs expected by the helpers
# above. See `docs/developers/calibration_guide.md` for a walkthrough
# (file will be created in Phase 3 of the calibration refactor).
#
# DESIGN DRAFT: this project is not dispatched by `hmp run` in v1.
# The analytical cases live under
# `hydromodpy.calibration.cases` and are loaded directly from Python.
# ======================================================================

case = "groundwater_1d"

# --- Chronicle (synthetic truth + noisy observations) ---------------

[workflow]
mode = "calibration_case"

[workspace]
project_root = "."

[chronicle]
# Time discretization
n_days = 120
dt_days = 1.0

# Domain and interface
L_m = 500.0
xi_true_m = 220.0
nx = 51

# Governing equation option: "linearized" or "boussinesq"
formulation_true = "boussinesq"
H_linearized_m = 12.0

# True hydraulic properties used to generate synthetic observations
Kam_true_m_per_day = 5.0
Kav_true_m_per_day = 1.2
Syam_true = 0.18
Syav_true = 0.10

# Upstream imposed head (constant in time). Initial condition is
# automatically set to h(x, 0) = h0 everywhere.
h0_m = 6.0

# Recharge forcing: "hydro_step" (seasonal two-step) or
# "reservoir_chronicle" (derived from a synthetic daily precipitation
# chronicle routed through a simple reservoir bucket).
recharge_mode = "reservoir_chronicle"

# --- Parameters specific to recharge_mode = "hydro_step"
recharge_wet_m_per_day = 0.0030
recharge_dry_m_per_day = 0.0004
recharge_wet_months = [10, 11, 12, 1, 2, 3]

# --- Parameters specific to recharge_mode = "reservoir_chronicle"
start_year = 2000
target_annual_precip_mm = 800.0
precip_seed = 42
runoff_coeff = 0.15
losses_mm_day = 1.5
losses_months = [4, 5, 6, 7, 8, 9]

# --- Synthetic observations
# Empty list = automatic points at the middle of each zone.
obs_x_m = []
obs_t_stride = 2
obs_noise_std_m = 0.03
obs_seed = 123

# --- Nonlinear Picard controls (used only for Boussinesq formulation)
picard_max_iter = 40
picard_tol = 1.0e-7
picard_relaxation = 1.0
head_floor_m = 1.0e-6

# --- Calibration -----------------------------------------------------

[calibration]
method = "optuna"
max_iter = 50
seed = 42
objective = "rmse"

# Optimizer-specific knobs forwarded to `build_optimizer(**kwargs)`.
[calibration.optimizer_kwargs]
sampler = "tpe"

# Bounds override the defaults declared in `default_parameter_space()`.
# Keys must be the canonical MODEL_PARAMETER_ORDER names.
[calibration.parameters.Kam]
bounds = [1.0, 10.0]

[calibration.parameters.Kav]
bounds = [0.2, 5.0]

[calibration.parameters.Syam]
bounds = [0.05, 0.35]

[calibration.parameters.Syav]
bounds = [0.03, 0.30]

[calibration.parameters.xi]
bounds = [50.0, 450.0]
