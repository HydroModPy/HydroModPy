{
  "summary_schema_version": "capability_gallery_case_v1",
  "slug": "linearized_unconfined_hillslope_drainage_1d",
  "title": "Linearized Unconfined Hillslope Drainage 1D",
  "category": "validation",
  "deck": "Steady synthetic groundwater-flow case used to validate one sloping-topography setup with distributed top drainage under the linearized unconfined model.",
  "summary": "Steady synthetic groundwater-flow case used to validate one sloping-topography setup with distributed top drainage under the linearized unconfined model.",
  "case_setup": [
    "geometry: quasi-1D strip (`50 x 5`, single layer for launcher-backed runs),",
    "topography: linear, from `7.0 m` on the west side to `5.0 m` on the east side,",
    "aquifer thickness: `30.0 m`,",
    "west/east heads: `7.25 m` / `5.25 m`,",
    "drainage conductance: `1e-5 m2/s`,",
    "simulated observable: `watertable_elevation`.",
    "Available solver variants: MODFLOW-NWT, MODFLOW 6, MODFLOW 6 irregular triangles."
  ],
  "key_parameters": [],
  "how_to_read": [],
  "next_steps": [],
  "what_it_shows": [
    "Sloping-topography drainage behavior without introducing a free seepage-face problem",
    "Primary metrics: head-profile RMSE, max abs error, cross-row spread, minimum clearance above topography.",
    "Solver-specific figures and metrics are shown side by side so the same benchmark can be read across backends."
  ],
  "reference_highlights": [
    "compared quantity: row-averaged head profile along `x`,",
    "reference: steady linearized solution of `T h'' - c_a (h - z_top) = 0`,"
  ],
  "equations_rst": [
    "T_0\\,\\frac{\\mathrm{d}^2u}{\\mathrm{d}x^2}-\\lambda_d\\,u=0,\\qquad u=h-z_{\\mathrm{top}}(x)",
    "z_{\\mathrm{top}}(x)=z_0+A\\left(1-\\frac{x-x_{\\min}}{L}\\right),\\qquad u(x)=u_w\\frac{\\sinh\\left(\\beta(L-x)\\right)}{\\sinh\\left(\\beta L\\right)}+u_e\\frac{\\sinh\\left(\\beta x\\right)}{\\sinh\\left(\\beta L\\right)}"
  ],
