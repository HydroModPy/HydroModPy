  "title": "Dupuit Fixed-Head 1D",
  "category": "validation",
  "deck": "Baseline 1D unconfined profile between two imposed heads.",
  "summary": "Steady synthetic groundwater-flow case used to validate the launcher workflow against the Dupuit analytical profile for an unconfined aquifer with fixed heads at both ends.",
  "case_setup": [
    "Homogeneous unconfined strip, fixed west/east heads, no recharge",
    "Available solver variants: MODFLOW-NWT, MODFLOW 6, Boussinesq."
  ],
  "what_it_shows": [
    "check that the end-to-end launcher workflow reproduces the expected head profile on a simple homogeneous domain,",
    "keep one lightweight, deterministic benchmark for future validation cases.",
    "Baseline launcher chain, side Dirichlet boundaries, free-surface equilibrium on a simple domain",
    "Primary metrics: head-profile RMSE, max abs error, cross-row spread.",
    "Solver-specific figures and metrics are shown side by side so the same benchmark can be read across backends."
  ],
  "reference_highlights": [
    "compared quantity: domain-averaged head profile along `x`",
    "reference: Dupuit steady fixed-head solution"
  ],
  "equations_rst": [
    "\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(K\\,h\\,\\frac{\\mathrm{d}h}{\\mathrm{d}x}\\right)=0",
    "h(x)=\\sqrt{h_w^2+\\left(h_e^2-h_w^2\\right)\\frac{x-x_{\\min}}{x_{\\max}-x_{\\min}}}"
  ],
  "reproduction_command": "python -m validation_cases.analytical.steady.dupuit_fixed_head_1d.run_case --no-show",
