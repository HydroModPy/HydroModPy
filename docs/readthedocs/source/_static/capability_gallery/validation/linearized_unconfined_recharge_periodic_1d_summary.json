{
  "summary_schema_version": "capability_gallery_case_v1",
  "slug": "linearized_unconfined_recharge_periodic_1d",
  "title": "Linearized Unconfined 1D Periodic Recharge",
  "category": "validation",
  "deck": "1D sinusoidal recharge benchmark.",
  "summary": "This case validates the transient linearized Boussinesq-Dupuit response of an unconfined 1D aquifer submitted to a sinusoidal recharge forcing.",
  "case_setup": [
    "geometry: quasi-1D Cartesian grid (`50 x 5`, single layer),",
    "flow regime: transient unconfined flow,",
    "west/east boundaries: fixed at `10.0 m`,",
    "recharge forcing: `5.0 + 5.0 * sin(2\u03c0 t / 10 d)` mm/day sampled every `1 day`,",
    "initial condition: uniform `10.0 m`,",
    "simulated observable: `watertable_elevation`.",
    "Available solver variants: MODFLOW-NWT, MODFLOW 6, Boussinesq."
  ],
  "what_it_shows": [
    "Periodic recharge forcing and phase/amplitude propagation in transient flow",
    "Primary metrics: space-time RMSE, space-time max abs error, final-profile RMSE, cross-row spread.",
    "Solver-specific figures and metrics are shown side by side so the same benchmark can be read across backends."
  ],
  "reference_highlights": [
    "Linearized transient response to sinusoidal recharge"
  ],
  "equations_rst": [
    "S_y\\frac{\\partial \\eta}{\\partial t}=T_0\\frac{\\partial^2 \\eta}{\\partial x^2}+R(t),\\qquad h=h_0+\\eta",
    "R(t)=\\overline{R}+A\\sin\\left(2\\pi t/P+\\phi\\right)"
  ],
  "reproduction_command": "python -m validation_cases.analytical.transient.linearized_unconfined_recharge_periodic_1d.run_case --no-show",
  "gallery_update_command": "python -m tools.doc_gallery",
