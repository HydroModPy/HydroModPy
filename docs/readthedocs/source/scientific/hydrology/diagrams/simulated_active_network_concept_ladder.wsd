@startuml
title Simulated Active Network - Concept Ladder
left to right direction
skinparam componentStyle rectangle
skinparam wrapWidth 180
skinparam maxMessageSize 160

package "Solver output" {
  component "raw DRN budget\nsigned by backend convention" as RawDrn
  component "head / water table\nper timestep" as Head
  component "solver mesh\nsurface_top + connectivity" as Mesh
}

package "HydroModPy result fields" {
  component "outflow_drain\npositive local drain outflow\nm3/s, per cell" as Outflow
  component "accumulation_flux\nrouted accumulated outflow\nm3/s, per cell" as Accum
}

package "Computed interpretation views" {
  component "active mask\nthreshold on accumulation_flux" as Mask
  component "persistence map\nfraction of active timesteps" as Persistence
  component "occupancy metrics\nactive fraction / density" as Metrics
}

package "Human-facing products" {
  component "simulated_active_network\ncell-map figure" as Figure
  component "reference overlap metrics\nprecision / recall / F1 / Jaccard" as Overlap
}

package "Future optional contract" {
  component "aggregation rule\nthreshold + timestep/window + mode" as Rule
  component "hydrographic_network_simulated_active\npersisted vector role" as VectorRole
}

RawDrn --> Outflow : sign normalization\nand layer sum
Head ..> Outflow : drainage activates\nfrom solved heads
Outflow --> Accum : downstream routing
Mesh --> Accum : D8 or mesh graph
Accum --> Mask
Accum --> Persistence
Mask --> Metrics
Persistence --> Metrics
Mask --> Figure
Mask --> Overlap
Metrics --> Rule : informs choice
Persistence --> Rule : informs transient rules
Rule --> VectorRole : not automatic yet

note bottom of Outflow
Use this for local drainage
and mass-balance reading.
end note

note bottom of Accum
Use this to detect active
branches and confluences.
Do not sum it as a budget.
end note

note bottom of VectorRole
Current implementation stops before
declaring a canonical vector network.
end note
@enduml
