@startuml
title Field - Core Class Diagram

package "hydromodpy.spatial.mesh.model.planar_cell_mesh" {
  class PlanarCellMesh {
    +mesh: HydroMesh
    +centers: np.ndarray
    +n_cells
    +connectivity_rows
  }
}

package "hydromodpy.spatial.field.mesh_cells" {
  class MeshCell {
    +index: int
    +kind: str
    +node_indices: tuple[int, ...]
    +vertices: np.ndarray
    +centroid: tuple[float, float]
  }

  class MeshWithValues {
    +mesh: PlanarCellMesh
    +cell_values: np.ndarray
    +label: str | None
    +n_cells
  }

  class "mesh_cells(cell_mesh)" as mesh_cells << (F,#FFFFFF) function >>
  class "cell_values(cell_mesh, values)" as cell_values << (F,#FFFFFF) function >>
}

package "hydromodpy.spatial.field.field_spatial" {
  abstract class Field {
    +identifier: str
    +on_mesh(cell_mesh, cell_samples_per_axis=10)
    +from_dict(config)
    +from_toml(toml_path, section="field")
  }

  abstract class FieldDiscretization {
    +mesh: PlanarCellMesh
    +field_id: str
    +aggregation_name()
    +aggregation
    +weighted_components()
  }
}

package "hydromodpy.spatial.field.field_spatial" {
  class WeightedAverageFieldDiscretization {
    +zone_keys: tuple[str, ...]
    +fractions_by_zone: dict[str, np.ndarray]
    +aggregation_name()
    +weighted_components()
  }
}

package "hydromodpy.spatial.field.field_param" {
  class FieldParam {
    +identifier: str
    +kind: str
    +value: float | None
    +values_by_key: dict[str, float] | None
    +field_spatial_id: str | None
    +to_array(...)
    +to_mesh_field(field_discretization=None, mesh=None, label=None)
    +map_zone_ids(zone_ids)
    +as_dict()
    +from_dict(config)
    +from_toml(toml_path, section="field")
  }
}

mesh_cells ..> PlanarCellMesh : reads
mesh_cells ..> MeshCell : one per cell
cell_values ..> PlanarCellMesh : checks the size
MeshWithValues --> PlanarCellMesh

FieldDiscretization --> PlanarCellMesh
FieldDiscretization <|-- WeightedAverageFieldDiscretization

Field ..> mesh_cells : samples the cells
Field ..> FieldDiscretization : on_mesh(...)

FieldParam ..> PlanarCellMesh : homogeneous mapping
FieldParam ..> FieldDiscretization : heterogeneous mapping
FieldParam ..> MeshWithValues : returns

@enduml
