@startuml
title Data definition and transfer - classes

package "hydromodpy.project" {
  class "project.phases" as ProjectPhases <<module>> {
    +builds the DataLoadPlan
  }
}

package "hydromodpy.workflow" {
  class LoadDataStep {
    +reads
    +writes
    +run(state)
  }
  class "workflow.steps.data" as DataStepModule <<module>> {
    +step_data_loading(ctx)
    +run_data(config_path, data_plan, run_state)
    +apply_structural_updates_from_data(run_state)
  }
}

package "hydromodpy.core.state" {
  class WorkflowContext {
    +cfg
    +raw_toml
    +data_plan: DataLoadPlan
    +setup: SetupContext
    +loaded_data: LoadedDataContext
  }

  class SetupContext {
    +domain
    +flow
    +transport
  }

  class LoadedDataContext {
    +geology
    +oceanic
    +hydrography
    +hydrometry
    +recharge
    +precipitation
    +etp
    +loaded_plan_types
  }
}

package "hydromodpy.data.loading" {
  class DataPlanner {
    +build(config, domain_zone_ids, flow_active_bc, ...)
  }

  class DataLoadPlan {
    +explicit_types
    +inferred_types
    +reasons_by_type
  }

  class DataManagersRuntimeLoader {
    +load_all(run_state)
  }
}

package "hydromodpy.spatial.field.geology" {
  class GeologyField
}

package "hydromodpy.spatial.domain" {
  class Domain {
    +set_zone(name, zone)
  }
}

package "hydromodpy.physics.flow" {
  class Flow
  class "structure_binders" as FlowBinders <<module>> {
    +apply_oceanic_to_flow(...)
    +apply_recharge_load_result_to_flow(...)
    +apply_etp_load_result_to_flow(...)
    +apply_lake_geometry_to_flow(...)
    +apply_sfr_network_to_flow(...)
  }
}

package "hydromodpy.spatial.geographic" {
  class "structure_binders" as DomainBinders <<module>> {
    +apply_geology_to_domain(domain, geology)
  }
}

ProjectPhases --> DataPlanner : build(...)
DataPlanner ..> DataLoadPlan : returns
ProjectPhases --> WorkflowContext : stores data_plan
LoadDataStep --> DataStepModule : delegates
DataStepModule --> DataManagersRuntimeLoader : load_all(run_state)
DataManagersRuntimeLoader --> LoadedDataContext : fills one field per variable
DataManagersRuntimeLoader ..> GeologyField : builds when geology is active

WorkflowContext *-- SetupContext
WorkflowContext *-- LoadedDataContext

DataStepModule --> DomainBinders : apply_geology_to_domain
DomainBinders --> Domain : set_zone("geology", geology)
DataStepModule --> FlowBinders : apply_*_to_flow
FlowBinders --> Flow : writes recharge, ETP, lakes, SFR
@enduml
