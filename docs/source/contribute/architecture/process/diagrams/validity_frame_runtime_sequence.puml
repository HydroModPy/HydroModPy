@startuml
title validity_frame - capture sequence

actor Caller
participant "create_validity_frame()" as Loader
participant "AutoCaptureCollector" as Collector
participant "Probes\n(system, hardware, runtime, solver)" as Probes
participant "Run being observed" as Run

Caller -> Loader: create_validity_frame(name)
Loader --> Caller: frame\n(entry point of validity_frame.frames)

Caller -> Collector: AutoCaptureCollector(context, probes)
Caller -> Collector: capture_start_with_time()
Collector -> Probes: collect initial state
Probes --> Collector: start data
Collector --> Caller: AutoCaptureSnapshot, start time

Caller -> Run: execute

alt the run succeeds
  Caller -> Collector: capture_end(start_time, ...)
  Collector -> Probes: collect end state and solver metrics
  Probes --> Collector: end data
  Collector --> Caller: AutoCaptureSnapshot (completed)
else the run raises
  Caller -> Collector: capture_exception(start_time, exc, ...)
  Collector -> Probes: collect end state
  Probes --> Collector: end data
  Collector --> Caller: AutoCaptureSnapshot (failed, with exception)
end

Caller -> Caller: verify(state, steps)\nwith the frame
@enduml
