@startuml
title Process - layer separation
left to right direction

package "User and orchestration" {
  component "hmp run / hmp.run" as Entry
  component "Project" as ProjectFacade
}

package "Configuration" {
  component "HydroModPyConfig" as HydroModPyConfig
  component "FlowConfig" as FlowConfig
  component "TransportConfig" as TransportConfig
  component "SimulationConfig\n([[simulation.process]])" as SimulationConfig
}

package "Data and forcing" {
  component "Data managers\n(hydromodpy.data)" as DataManagers
  component "Binders\n(physics.flow.structure_binders)" as Binders
  component "Forcing\n(physics.forcing, physics.hydrology)" as Forcing
}

package "Runtime process objects (physics)" {
  component "ProcessSpatial" as ProcessSpatial
  component "Flow" as Flow
  component "Transport" as Transport
}

package "Orchestration (simulation)" {
  component "SimulationPlanner" as Planner
  component "SimulationRunner" as Runner
}

package "Solver adapters and backends (solver)" {
  component "SolverAdapter\n(solver/<backend>/adapters)" as Adapter
  component "MODFLOW 6 / MODFLOW-NWT /\nBoussinesq" as Backends
}

Entry --> ProjectFacade
ProjectFacade --> HydroModPyConfig
HydroModPyConfig --> FlowConfig
HydroModPyConfig --> TransportConfig
HydroModPyConfig --> SimulationConfig

FlowConfig --> Flow : ensure_flow
TransportConfig --> Transport : ensure_transport
Flow --> ProcessSpatial : extends
Transport --> ProcessSpatial : extends

DataManagers --> Binders : loaded data
Forcing --> Binders : aligned series
Binders --> Flow : fills recharge, ETP,\nlakes, SFR

SimulationConfig --> Planner
Planner --> Runner : SimulationPlan
Runner --> Flow
Runner --> Transport
Runner --> Adapter : by run.solver
Adapter --> Backends : only layer that\ntranslates to solver input
@enduml
