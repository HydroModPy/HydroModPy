@startuml
title Calibration - one session from hmp run

actor User
participant "cli_runner.py" as Runner
participant "CalibrationConfig" as Config
participant "trial.py" as Trial
participant "CalibrationEngine" as Engine
participant "Optimizer\n(optim/adapters)" as Optimizer
participant "ParamsHashCache" as Cache
participant "Evaluator\n(pipeline_evaluator.py)" as Evaluator
participant "CalibrationPersistence" as Persistence
participant "promotion.py" as Promotion

User -> Runner: hmp run calibration.toml
Runner -> Config: HydroModPyConfig validates [calibration]
Config --> Runner: CalibrationConfig
Runner -> Trial: prepare_trials()\n(geography, mesh, data built once)
Runner -> Engine: build ParameterSpace, optimizer, evaluator

loop until the stopping rule or the budget
  Engine -> Optimizer: ask(n)
  Optimizer --> Engine: ParamSuggestion
  Engine -> Cache: params hash seen?
  alt cache hit
    Cache --> Engine: stored EvaluationResult
  else new point
    Engine -> Evaluator: evaluate(TrialRequest)
    Evaluator -> Trial: run_trial_light(values)\nsteps from the first affected one,\nsolve, extract
    Trial --> Evaluator: simulated series and metrics
    Evaluator -> Evaluator: pair with observations,\nscore with the objective blocks
    Evaluator --> Engine: TrialOutcome (cost)
  end
  Engine -> Optimizer: tell(EvaluationResult)
  Engine -> Persistence: journal line, then index row
end

Engine --> Runner: CalibrationSession
Runner -> Promotion: replay the best trials\nthrough the full pipeline
Promotion --> Runner: run linked to its trial by sim_id
Runner --> User: recap, report
@enduml
