@startuml
title Simulation orchestration classes

package "hydromodpy.project" {
  class Project {
    +prepare()
    +setup_workspace()
    +build_geographic()
    +load_data()
    +build_mesh()
    +simulate(...) : Run
    +calibrate(...)
    +spinup(...)
  }
}

package "hydromodpy.workflow" {
  class Pipeline
  interface Step {
    +name
    +reads
    +writes
    +run(state) : PipelineState
  }
  class PipelineState
}

package "hydromodpy.simulation" {
  class SimulationPlanner {
    +build(config) : SimulationPlan
  }

  class SimulationPlan {
    +name: str
    +description: str
    +runs: tuple[ProcessRun, ...]
  }

  class ProcessRun {
    +id: str
    +process_id: str
    +process_type: str
    +solver: str
    +depends_on: tuple[str, ...]
  }

  class SimulationRunner {
    +execute(plan, ctx, callbacks, store)
  }

  class RunContext {
    +plan
    +run
    +state: RunState
    +dependency_models
    +store
    +model
    +output_dir
  }
}

package "hydromodpy.physics" {
  class ProcessSpatial
  class Flow
  class Transport
}

package "hydromodpy.solver" {
  interface SolverAdapter {
    +process_type
    +solver_name
    +requires
    +validate(ctx)
    +execute(ctx)
    +cleanup(ctx)
    +extract_observables(ctx, store, requests)
  }
  class ModflowNwtFlowAdapter
  class Modflow6FlowAdapter
  class BoussinesqFlowAdapter
  class ModpathTransportAdapter
  class Mt3dmsTransportAdapter
  class Modflow6GwtTransportAdapter
  class Modflow6PrtTransportAdapter
}

Project --> Pipeline : simulate() runs
Pipeline o-- "12" Step
Pipeline ..> PipelineState : threads

SimulationPlanner ..> SimulationPlan : returns
SimulationPlan *-- "0..*" ProcessRun : runs

SimulationRunner ..> SimulationPlan : consumes ordered runs
SimulationRunner ..> RunContext : builds one per run
SimulationRunner ..> Flow : ensure_flow
SimulationRunner ..> Transport : ensure_transport
SimulationRunner ..> SolverAdapter : resolves from run.solver

Flow --|> ProcessSpatial
Transport --|> ProcessSpatial

SolverAdapter <|.. ModflowNwtFlowAdapter
SolverAdapter <|.. Modflow6FlowAdapter
SolverAdapter <|.. BoussinesqFlowAdapter
SolverAdapter <|.. ModpathTransportAdapter
SolverAdapter <|.. Mt3dmsTransportAdapter
SolverAdapter <|.. Modflow6GwtTransportAdapter
SolverAdapter <|.. Modflow6PrtTransportAdapter

note right of Pipeline
  The planning step builds the plan
  with SimulationPlanner. RunSolverStep
  hands it to SimulationRunner.
end note
@enduml
