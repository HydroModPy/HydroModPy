@startuml
title Stream Boundary Versus Seepage / Drainage Operator
left to right direction
skinparam componentStyle rectangle
skinparam wrapWidth 170

package "Stream-style exchange" {
  component "Known input\nstream support + stage/head" as StreamInput
  component "Solver constraint\nhead imposed or stage-controlled" as StreamLaw
  component "Unknown output\nexchange flux after solve" as StreamOutput
}

package "Seepage / drainage exchange" {
  component "Known input\nsupport + conductance + threshold" as DrainInput
  component "Solver law\nrelease only when head activates condition" as DrainLaw
  component "Unknown output\npositive groundwater outflow" as DrainOutput
}

package "Common interpretation" {
  component "Both are near-surface exchanges" as Common
  component "Neither is diffuse recharge" as NotRecharge
  component "Neither is observed runoff" as NotRunoff
}

StreamInput --> StreamLaw
StreamLaw --> StreamOutput
DrainInput --> DrainLaw
DrainLaw --> DrainOutput

StreamOutput --> Common
DrainOutput --> Common
Common --> NotRecharge
Common --> NotRunoff

note bottom of StreamLaw
Question answered:
what flux is induced by
the prescribed stream stage?
end note

note bottom of DrainLaw
Question answered:
where does groundwater emerge
or leave through a head-dependent
surface release condition?
end note
@enduml
