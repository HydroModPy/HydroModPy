@startuml
title HydroModPy - Global Component Architecture (accurate)
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam dpi 140
skinparam defaultFontName Arial
skinparam defaultFontSize 10

skinparam titleFontSize 14
skinparam legendFontSize 9
skinparam packageFontSize 10
skinparam componentFontSize 10
skinparam interfaceFontSize 9
skinparam noteFontSize 9

skinparam nodesep 40
skinparam ranksep 50

skinparam package {
  BackgroundColor #F9FAFB
  BorderColor #94A3B8
  FontColor #0F172A
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
}
skinparam interface {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D4A72C
  FontColor #111827
}

skinparam component<<entry>> {
  BackgroundColor #FFE7B3
  BorderColor #B45309
  FontColor #7C2D12
}
skinparam component<<aggregate>> {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
}
skinparam component<<facade>> {
  BackgroundColor #E0F2FE
  BorderColor #0284C7
}
skinparam interface<<real interface>> {
  BackgroundColor #DCFCE7
  BorderColor #16A34A
}
skinparam interface<<conceptual port>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

legend right
|= Notation |= Meaning |
| <<entry>> | Entrée exécutable (CLI/API) |
| <<real interface>> | Protocol / ABC Python réel |
| <<conceptual port>> | Contrat d'architecture |
| <<aggregate>> | Groupe de modules/composants |
| <<facade>> | Couche façade / re-export |
| --\|> | Réalise interface |
| -() | Port fourni (lollipop) |
| -( | Port requis (socket) |
| --> | Dépend de |
| ..> | Utilise (faible) |
endlegend

package "API Entry Points" <<facade>> {
  component "CLI dispatch\n(hydromodpy.cli)" as CLIMain <<entry>>
  component "API Façade\n(run, calibrate, mesh)\n(hydromodpy.__init__)" as APIFacade <<entry>>
  component "Project Façade\n(interactive notebooks)\n(hydromodpy.project)" as ProjectFacade <<entry>>
}

package "Core Infrastructure" {
  component "TomlLoader\n(hydromodpy.core.toml_io)" as TomlLoader
  component "ConfigFactory\n(hydromodpy.config)" as ConfigFactory
  component "Workspace Runtime\n(hydromodpy.core)" as WorkspaceRuntime
  component "Workflow Orchestrator\n(hydromodpy.workflow.orchestrator)" as Orchestrator

  interface "WorkflowProvider" as WorkflowProviderProtocol <<real interface>>
  interface "ConfigProtocol" as ConfigProtocol <<real interface>>
}

package "Spatial Domain & Mesh" {
  component "Geographic Context\n(hydromodpy.spatial.geographic)" as GeoContext
  component "Spatial Support\n(hydromodpy.spatial.domain)" as SpatialSupport
  component "Field Abstraction" as FieldCore <<aggregate>>

  component "Cartesian Grid" as CartesianGrid
  component "Gmsh Grid" as GmshGrid
  component "Mesh Steps Runner" as MeshStepsRunner <<aggregate>>
  component "Mesh Adapters" as MeshAdapters <<aggregate>>

  interface "Field ABC" as FieldABC <<real interface>>
  interface "FieldMesh ABC" as FieldMeshABC <<real interface>>
  interface "MeshAdapter Protocol" as MeshAdapterProtocol <<real interface>>
}

package "Data Loading & Registry" {
  component "Data Registry" as DataRegistry
  component "Data Loaders" as DataLoaders
  component "Data Adapters" as DataAdapters <<aggregate>>
  component "DuckDB Catalog" as DuckDBCatalog

  interface "SourceConfig Protocol" as SourceConfigProtocol <<real interface>>
  interface "DataStore Protocol" as DataStoreProtocol <<real interface>>
}

package "Physics & Processes" {
  component "Flow Domain" as FlowPhysics
  component "Transport Domain" as TransportPhysics
  interface "ProcessSpatial ABC" as ProcessSpatialProtocol <<real interface>>
}

package "Simulation Execution & Dispatch" {
  component "Simulation Planner" as SimulationPlanner
  component "Simulation Runner" as SimulationRunner

  component "Solver Adapter Registry" as AdapterRegistry
  component "Solver Registry Provider" as SolverProviderDI

  interface "SolverAdapter Protocol" as SolverAdapterProtocol <<real interface>>
  interface "SolverRegistryProvider" as RegistryProviderProtocol <<real interface>>
}

package "Solver Backends" {
  component "Boussinesq Solver" as BoussinesqSolver
  component "MODFLOW NWT" as ModflowNwt
  component "MODFLOW 6" as Modflow6

  component "Boussinesq Adapter" as BoussinesqAdapter <<aggregate>>
  component "MODFLOW NWT Adapter" as ModflowNwtAdapter <<aggregate>>
  component "MODFLOW 6 Adapter" as Modflow6Adapter <<aggregate>>

  component "Transport Adapters" as TransportAdapters <<aggregate>>

  interface "Solver ABC" as SolverABC <<real interface>>
}

package "Analysis & Calibration" {
  component "Calibration Adapters" as CalibrationAdapters <<aggregate>>
  component "Batch Orchestration" as BatchOrchestration
  component "Postprocess Runner" as PostprocessRunner
  component "Visualization Engine" as DisplayEngine <<aggregate>>

  interface "BaseFigure ABC" as BaseFigureABC <<real interface>>
}

package "Results Management" {
  component "Results Catalog" as ResultsCatalog
  interface "ResultsCatalog Protocol" as ResultsCatalogProtocol <<real interface>>
}

package "Calibration Runtime" {
  component "Calibration Dispatch" as CalibrationDispatch
  component "Calibration Engine" as CalibrationEngine
  component "Trial Runner" as TrialRunner
  component "Optimizer" as CalibrationOptimizer

  interface "Optimizer Protocol" as OptimizerProtocol <<real interface>>
}

package "Legacy/Annex" {
  component "Legacy Annex" as LegacyAnnex <<aggregate>>
}

' ===== MAIN FLOW (Red) =====
CLIMain --|> WorkflowProviderProtocol
APIFacade --|> WorkflowProviderProtocol
ProjectFacade --|> WorkflowProviderProtocol

CLIMain -[#C2410C,thickness=2]-> TomlLoader : 1) read
TomlLoader -[#C2410C,thickness=2]-> ConfigFactory : 2) validate
ConfigFactory -[#C2410C,thickness=2]-> WorkspaceRuntime : 3) setup
WorkspaceRuntime -[#C2410C,thickness=2]-> Orchestrator : enters

Orchestrator -[#C2410C,thickness=2]-> DataRegistry : 4) plan
DataRegistry -[#C2410C,thickness=2]-> DataLoaders
DataLoaders -[#C2410C,thickness=2]-> DataAdapters
DataAdapters -[#C2410C,thickness=2]-> DuckDBCatalog

Orchestrator -[#C2410C,thickness=2]-> GeoContext : 5) build
GeoContext -[#C2410C,thickness=2]-> SpatialSupport

Orchestrator -[#C2410C,thickness=2]-> CartesianGrid : 6a)
Orchestrator -[#C2410C,thickness=2]-> GmshGrid : 6b)
CartesianGrid -[#C2410C,thickness=2]-> MeshStepsRunner
GmshGrid -[#C2410C,thickness=2]-> MeshStepsRunner
MeshStepsRunner -[#C2410C,thickness=2]-> MeshAdapters

Orchestrator -[#C2410C,thickness=2]-> SimulationPlanner : 7) plan
SimulationPlanner -[#C2410C,thickness=2]-> AdapterRegistry

Orchestrator -[#C2410C,thickness=2]-> SimulationRunner : 8) execute
SimulationRunner -[#C2410C,thickness=2]-> SolverProviderDI
SolverProviderDI -[#C2410C,thickness=2]-> AdapterRegistry

CalibrationDispatch -[#C2410C,thickness=2]-> CalibrationEngine : 11)
CalibrationEngine -[#C2410C,thickness=2]-> CalibrationOptimizer : 12)
CalibrationEngine -[#C2410C,thickness=2]-> TrialRunner : 13)
TrialRunner -[#C2410C,thickness=2]-> SimulationRunner : 14)
TrialRunner -[#C2410C,thickness=2]-> ResultsCatalog : 15)

' ===== SOLVER DISPATCH (Green) =====
AdapterRegistry -[#0F766E,thickness=2]..> BoussinesqAdapter
AdapterRegistry -[#0F766E,thickness=2]..> ModflowNwtAdapter
AdapterRegistry -[#0F766E,thickness=2]..> Modflow6Adapter
AdapterRegistry -[#0F766E,thickness=2]..> TransportAdapters

BoussinesqAdapter --|> SolverAdapterProtocol
ModflowNwtAdapter --|> SolverAdapterProtocol
Modflow6Adapter --|> SolverAdapterProtocol
TransportAdapters --|> SolverAdapterProtocol

BoussinesqAdapter -[#0F766E,thickness=2]..> BoussinesqSolver
ModflowNwtAdapter -[#0F766E,thickness=2]..> ModflowNwt
Modflow6Adapter -[#0F766E,thickness=2]..> Modflow6

' ===== RESULTS & POST-PROCESSING =====
SimulationRunner -[#C2410C,thickness=2]-> ResultsCatalog : 9)
ResultsCatalog -[#C2410C,thickness=2]-> DisplayEngine

Orchestrator -[#C2410C,thickness=2]-> PostprocessRunner : 10)
PostprocessRunner -[#C2410C,thickness=2]-> DisplayEngine

' ===== PROTOCOLS & IMPLEMENTATIONS =====
GeoContext --|> ProcessSpatialProtocol
FlowPhysics --|> ProcessSpatialProtocol
TransportPhysics --|> ProcessSpatialProtocol

FieldCore --|> FieldABC
MeshAdapters --|> FieldMeshABC
MeshAdapters --|> MeshAdapterProtocol

TomlLoader --|> ConfigProtocol
ConfigFactory --|> ConfigProtocol
DuckDBCatalog --|> DataStoreProtocol
ResultsCatalog --|> ResultsCatalogProtocol
CalibrationAdapters --|> OptimizerProtocol
CalibrationOptimizer --|> OptimizerProtocol
BoussinesqSolver --|> SolverABC
ModflowNwt --|> SolverABC
Modflow6 --|> SolverABC
DisplayEngine --|> BaseFigureABC

' ===== PORTS (LOLLIPOP & SOCKETS) =====
' Provided Ports
TomlLoader -() WorkflowProviderProtocol
ConfigFactory -() WorkflowProviderProtocol
GeoContext -() ProcessSpatialProtocol
MeshAdapters -() MeshAdapterProtocol
DuckDBCatalog -() DataStoreProtocol
BoussinesqAdapter -() SolverAdapterProtocol
ModflowNwtAdapter -() SolverAdapterProtocol
Modflow6Adapter -() SolverAdapterProtocol

' Required Ports
CLIMain -( WorkflowProviderProtocol
APIFacade -( WorkflowProviderProtocol
ProjectFacade -( WorkflowProviderProtocol
SimulationRunner -( SolverAdapterProtocol
DataLoaders -( SourceConfigProtocol
SpatialSupport -( ProcessSpatialProtocol
PostprocessRunner -( BaseFigureABC

' ===== NOTES =====
note bottom of Orchestrator
  **Orchestrator Pattern**:
  - prepare_runtime()
  - execute_run()
  Centralized state machine
end note

note bottom of SolverProviderDI
  **Dependency Injection**:
  Decouples simulation from
  specific solver backends.
end note

note right of APIFacade
  **Façade Pattern**:
  Single entry point for
  notebooks and scripts.
end note

@enduml