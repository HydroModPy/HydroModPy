"""
Pydantic chronicle schema for the __CASE_TITLE__ case.

Purpose of this file:
- define accepted `[chronicle]` keys and defaults,
- enforce domain constraints with validators,
- return plain Python values for the workflow layer.
"""

from __future__ import annotations

from typing import Any, Mapping

from pydantic import BaseModel, ConfigDict, ValidationError, field_validator


class ChronicleSchema(BaseModel):
    """
    Input schema for `[chronicle]`.

    `extra="forbid"` is important: unknown keys fail fast instead of being
    silently ignored.
    """

    model_config = ConfigDict(extra="forbid")

    n_points: int = 60
    gain_true: float = 1.2
    bias_true: float = 0.1
    noise_fraction: float = 0.05
    seed: int = 42

    @field_validator("n_points")
    @classmethod
    def _validate_n_points(cls, value):
        if int(value) <= 2:
            raise ValueError("n_points must be > 2")
        return int(value)

    @field_validator("gain_true")
    @classmethod
    def _validate_gain_true(cls, value):
        if float(value) <= 0.0:
            raise ValueError("gain_true must be > 0")
        return float(value)

    @field_validator("noise_fraction")
    @classmethod
    def _validate_noise_fraction(cls, value):
        out = float(value)
        if out < 0.0:
            raise ValueError("noise_fraction must be >= 0")
        return out

    @field_validator("bias_true")
    @classmethod
    def _validate_bias_true(cls, value):
        return float(value)

    @field_validator("seed")
    @classmethod
    def _validate_seed(cls, value):
        return int(value)


def validate_case_chronicle_config(chronicle_cfg: Mapping[str, Any]) -> dict[str, Any]:
    """
    Validate chronicle settings and return normalized plain values.

    Keeping this small adapter function makes the rest of the case independent
    from Pydantic internals.
    """
    try:
        parsed = ChronicleSchema.model_validate(dict(chronicle_cfg))
    except ValidationError as exc:
        raise ValueError(str(exc)) from exc
    return parsed.model_dump(mode="python")


__all__ = (
    "ChronicleSchema",
    "validate_case_chronicle_config",
)
