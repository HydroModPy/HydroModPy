"""
Run calibration for the __CASE_TITLE__ case.

This script is intentionally short: it demonstrates the canonical entrypoint
for TOML-driven calibration runs with the generic orchestrator.
"""

from __future__ import annotations

from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[4]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from hydromodpy.analysis.calibration.core.case_orchestrator import run_calibration_case_from_toml
from hydromodpy.analysis.calibration.cases.__CASE_NAME__.case_implementation import CASE_IMPLEMENTATION


DEFAULT_CONFIG_FILE = "config_calibration.toml"


def main():
    """Load default config, run calibration, and print a compact summary."""
    config_path = Path(__file__).with_name(DEFAULT_CONFIG_FILE)
    calibration = run_calibration_case_from_toml(
        config_path=config_path,
        case_implementation=CASE_IMPLEMENTATION,
    )
    result = calibration["result"]
    print("Calibration summary")
    print(f"  case             : __CASE_NAME__")
    print(f"  objective metric : {calibration['objective_metric']}")
    print(f"  method           : {calibration['method']}")
    print(f"  n evaluations    : {int(result.n_evaluations)}")
    print(f"  params_best      : {result.params_best}")
    print(f"  metrics          : {calibration.get('metrics')}")


if __name__ == "__main__":
    main()
