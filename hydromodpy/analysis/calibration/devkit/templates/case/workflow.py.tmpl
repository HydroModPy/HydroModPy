"""
Workflow helpers for the __CASE_TITLE__ calibration case.

This module is deliberately case-specific. It should contain:
- chronicle construction (`build_noisy_chronicle`),
- simulator adapter factory (`make_simulator`),
- optional diagnostic helpers (`evaluate_metrics`).

The generic calibration engine remains in `core/`.
"""

from __future__ import annotations

import numpy as np

from hydromodpy.analysis.calibration.analysis.diagnostics import compute_performance_metrics


MODEL_PARAMETER_ORDER = ("gain", "bias")


def build_noisy_chronicle(chronicle_cfg):
    """
    Build a synthetic chronicle for a linear model `q = gain * forcing + bias`.

    Replace this with your real data loader if your case uses observations from
    files/databases instead of synthetic data.
    """
    n_points = int(chronicle_cfg["n_points"])
    gain_true = float(chronicle_cfg["gain_true"])
    bias_true = float(chronicle_cfg["bias_true"])
    noise_fraction = float(chronicle_cfg["noise_fraction"])
    seed = int(chronicle_cfg["seed"])

    t = np.arange(n_points, dtype=float)
    forcing = 1.0 + 0.4 * np.sin(2.0 * np.pi * t / max(n_points - 1.0, 1.0))
    q_true = gain_true * forcing + bias_true

    rng = np.random.default_rng(seed)
    scale = noise_fraction * np.maximum(np.abs(q_true), 1.0e-8)
    q_obs = q_true + rng.normal(loc=0.0, scale=scale, size=q_true.shape)

    return {
        "t": t,
        "forcing": forcing,
        "q_true": q_true,
        "q_obs": q_obs,
        "true_params": {"gain": gain_true, "bias": bias_true},
    }


def make_simulator(forcing):
    """
    Return simulator compatible with `CalibrationEngine`.

    Expected signature is:
    `simulator(params_dict) -> 1D simulated series`.
    """
    forcing_vec = np.asarray(forcing, dtype=float).ravel()
    if forcing_vec.size == 0:
        raise ValueError("forcing cannot be empty")

    def _simulate(params):
        # Parameter names must match MODEL_PARAMETER_ORDER.
        gain = float(params["gain"])
        bias = float(params["bias"])
        return gain * forcing_vec + bias

    return _simulate


def evaluate_metrics(observed, simulated):
    """Evaluate common calibration metrics for quick diagnostics."""
    return compute_performance_metrics(
        observed=observed,
        simulated=simulated,
        nse_log_floor=1.0e-8,
    )


__all__ = (
    "MODEL_PARAMETER_ORDER",
    "build_noisy_chronicle",
    "make_simulator",
    "evaluate_metrics",
)
