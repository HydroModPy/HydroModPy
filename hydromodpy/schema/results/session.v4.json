{
  "$defs": {
    "BestCase": {
      "additionalProperties": true,
      "description": "What the best trial gave in one case: its run and its cost.",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost of this case at this trial",
          "title": "Cost",
          "x-hmp-profile": "user"
        },
        "rel_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directory of that run, a hint",
          "title": "Rel Dir",
          "x-hmp-profile": "user"
        },
        "sim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run of the trial in this case",
          "title": "Sim Id",
          "x-hmp-profile": "user"
        }
      },
      "title": "BestCase",
      "type": "object"
    },
    "BestTrial": {
      "additionalProperties": true,
      "description": "The trial a session or a phase holds as its best.",
      "properties": {
        "cases": {
          "additionalProperties": {
            "$ref": "#/$defs/BestCase"
          },
          "description": "By case id",
          "title": "Cases",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost of the trial, null when the search keeps no single cost",
          "title": "Cost",
          "x-hmp-profile": "user"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Physical value of each parameter of the trial, those a phase froze included",
          "title": "Parameters",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "trial": {
          "description": "Trial number, unique in the session",
          "examples": [
            1
          ],
          "minimum": 1,
          "title": "Trial",
          "type": "integer",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "trial"
      ],
      "title": "BestTrial",
      "type": "object"
    },
    "CostInterval": {
      "additionalProperties": true,
      "description": "The range the trials could not tell from the best on the cost. Every member is optional.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the margin reads: relative, absolute",
          "title": "Kind",
          "x-hmp-profile": "user"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Low end, in the unit of the parameter",
          "title": "Lower",
          "x-hmp-profile": "user"
        },
        "lower_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crossed, open or bound",
          "title": "Lower End",
          "x-hmp-profile": "user"
        },
        "margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Width on the cost it was read with",
          "title": "Margin",
          "x-hmp-profile": "user"
        },
        "n_trials": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trials it was read over",
          "title": "N Trials",
          "x-hmp-profile": "user"
        },
        "n_within": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trials inside the margin",
          "title": "N Within",
          "x-hmp-profile": "user"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost at which it was read",
          "title": "Threshold",
          "x-hmp-profile": "user"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "High end, in the unit of the parameter",
          "title": "Upper",
          "x-hmp-profile": "user"
        },
        "upper_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crossed, open or bound",
          "title": "Upper End",
          "x-hmp-profile": "user"
        }
      },
      "title": "CostInterval",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": true,
      "description": "A closed range of days, ``start`` and ``end`` included.",
      "properties": {
        "end": {
          "description": "Last day of the window, included",
          "format": "date",
          "title": "End",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "start": {
          "description": "First day of the window",
          "format": "date",
          "title": "Start",
          "type": "string",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "ParameterBound": {
      "additionalProperties": true,
      "description": "One dimension a search walks.",
      "properties": {
        "lower": {
          "description": "Lower physical bound",
          "examples": [
            1.0
          ],
          "title": "Lower",
          "type": "number",
          "x-hmp-profile": "user"
        },
        "search_space": {
          "description": "Space of the search: identity, log or logit",
          "examples": [
            "example"
          ],
          "title": "Search Space",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "targets": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Address of the value in each case it touches, by case id; empty for a parameter that writes nothing itself",
          "title": "Targets",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of the bounds",
          "title": "Units",
          "x-hmp-profile": "user"
        },
        "upper": {
          "description": "Upper physical bound",
          "examples": [
            1.0
          ],
          "title": "Upper",
          "type": "number",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "lower",
        "upper",
        "search_space"
      ],
      "title": "ParameterBound",
      "type": "object"
    },
    "ParameterWidth": {
      "additionalProperties": true,
      "description": "The width of one calibrated value. Every member is optional, and none changes the value.",
      "properties": {
        "correlated": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Correlation coefficient with other parameters, by name",
          "title": "Correlated",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interval on the cost",
          "x-hmp-profile": "user"
        },
        "restarts": {
          "anyOf": [
            {
              "$ref": "#/$defs/RestartRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spread of the restarts",
          "x-hmp-profile": "user"
        },
        "sigma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linearised standard deviation, in the unit of the parameter",
          "title": "Sigma",
          "x-hmp-profile": "user"
        }
      },
      "title": "ParameterWidth",
      "type": "object"
    },
    "PeriodWindow": {
      "additionalProperties": true,
      "description": "A named period of a search: its role, its extent, and the window of each case.",
      "properties": {
        "by_case": {
          "additionalProperties": {
            "$ref": "#/$defs/DateWindow"
          },
          "description": "Window of each case by case id, empty when every case reads start to end",
          "title": "By Case",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "end": {
          "description": "Last day of the period over all cases, included",
          "format": "date",
          "title": "End",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "role": {
          "description": "What the period is for",
          "examples": [
            "example"
          ],
          "title": "Role",
          "type": "string",
          "x-hmp-profile": "user",
          "x-hmp-vocabulary": [
            "calibration",
            "validation",
            "evaluation"
          ]
        },
        "start": {
          "description": "First day of the period over all cases",
          "format": "date",
          "title": "Start",
          "type": "string",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "role",
        "start",
        "end"
      ],
      "title": "PeriodWindow",
      "type": "object"
    },
    "ProtocolDeparture": {
      "additionalProperties": true,
      "description": "One place a session leaves the publication its protocol cites.",
      "properties": {
        "always": {
          "default": false,
          "description": "No value of an option brings it back",
          "examples": [
            false
          ],
          "title": "Always",
          "type": "boolean",
          "x-hmp-profile": "user"
        },
        "here": {
          "description": "What this implementation does",
          "examples": [
            "example"
          ],
          "title": "Here",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "key": {
          "description": "The option or the concept that carries the departure",
          "examples": [
            "example"
          ],
          "title": "Key",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "paper": {
          "description": "What the publication does",
          "examples": [
            "example"
          ],
          "title": "Paper",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value in force, none without option",
          "title": "Value",
          "x-hmp-profile": "user"
        },
        "written": {
          "default": false,
          "description": "The file wrote the value, rather than its version",
          "examples": [
            false
          ],
          "title": "Written",
          "type": "boolean",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "key",
        "here",
        "paper"
      ],
      "title": "ProtocolDeparture",
      "type": "object"
    },
    "RestartRange": {
      "additionalProperties": true,
      "description": "Where the restarts of a search landed on one parameter.",
      "properties": {
        "highest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest value of the restarts",
          "title": "Highest",
          "x-hmp-profile": "user"
        },
        "lowest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowest value of the restarts",
          "title": "Lowest",
          "x-hmp-profile": "user"
        },
        "values": {
          "description": "Value of each restart",
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array",
          "x-hmp-profile": "user"
        }
      },
      "title": "RestartRange",
      "type": "object"
    },
    "ScoredSamples": {
      "additionalProperties": true,
      "description": "The pairs one dated output of one case was scored on, in one period.\n\nA stamp closes its period, so ``first`` and ``last`` are the ends of the\nfirst and last period scored, not the bounds of a window.",
      "properties": {
        "case_id": {
          "description": "Case scored",
          "examples": [
            "example"
          ],
          "title": "Case Id",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "first": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First period-end stamp scored",
          "title": "First",
          "x-hmp-profile": "user"
        },
        "last": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last period-end stamp scored",
          "title": "Last",
          "x-hmp-profile": "user"
        },
        "n": {
          "description": "Number of paired samples scored",
          "examples": [
            1
          ],
          "minimum": 0,
          "title": "N",
          "type": "integer",
          "x-hmp-profile": "user"
        },
        "n_sim_nan": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pairs of the window dropped because the simulated value is NaN (a dry cell); null when not counted",
          "title": "N Sim Nan",
          "x-hmp-profile": "user"
        },
        "output": {
          "description": "Dated output scored; two cases may use one name",
          "examples": [
            "example"
          ],
          "title": "Output",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "window": {
          "description": "Name of the period scored",
          "examples": [
            "example"
          ],
          "title": "Window",
          "type": "string",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "window",
        "case_id",
        "output",
        "n"
      ],
      "title": "ScoredSamples",
      "type": "object"
    },
    "SessionCase": {
      "additionalProperties": true,
      "description": "One case a session calibrates.",
      "properties": {
        "config_file": {
          "description": "Frozen file of the case, relative to the session",
          "examples": [
            "example"
          ],
          "title": "Config File",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "config_hash": {
          "description": "Identity of the resolved configuration of the case",
          "examples": [
            "example"
          ],
          "title": "Config Hash",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "context": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "By phase, the fingerprint of each member of the cache context: a --resume refusal names the one that differs",
          "title": "Context",
          "type": "object",
          "x-hmp-profile": "user"
        },
        "cost_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the cost of this case reads as",
          "title": "Cost Label",
          "x-hmp-profile": "user"
        },
        "cost_name": {
          "description": "Name of the cost of this case",
          "examples": [
            "example"
          ],
          "title": "Cost Name",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "site": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Site of the case",
          "title": "Site",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "config_hash",
        "config_file",
        "cost_name"
      ],
      "title": "SessionCase",
      "type": "object"
    },
    "SessionProtocol": {
      "additionalProperties": true,
      "description": "The published method a session follows and where it leaves it.",
      "properties": {
        "departures": {
          "description": "Every departure from the publication in force",
          "items": {
            "$ref": "#/$defs/ProtocolDeparture"
          },
          "title": "Departures",
          "type": "array",
          "x-hmp-profile": "user"
        },
        "name": {
          "description": "Name of the protocol",
          "examples": [
            "example"
          ],
          "title": "Name",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "version": {
          "description": "Version the session ran, the pinned one or the installed one",
          "examples": [
            "example"
          ],
          "title": "Version",
          "type": "string",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SessionProtocol",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Identity, search and outcome of one calibration session.",
  "properties": {
    "best": {
      "anyOf": [
        {
          "$ref": "#/$defs/BestTrial"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Best trial so far; null when the search keeps no single best",
      "x-hmp-profile": "user"
    },
    "bounds": {
      "additionalProperties": {
        "$ref": "#/$defs/ParameterBound"
      },
      "description": "The dimensions the search walks, by parameter",
      "title": "Bounds",
      "type": "object",
      "x-hmp-profile": "user"
    },
    "case_id": {
      "description": "Case of the plan this directory is",
      "examples": [
        "example"
      ],
      "title": "Case Id",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "cases": {
      "additionalProperties": {
        "$ref": "#/$defs/SessionCase"
      },
      "description": "The calibrated cases, by case id",
      "title": "Cases",
      "type": "object",
      "x-hmp-profile": "user"
    },
    "config_hash": {
      "description": "Identity of the frozen configuration of this directory",
      "examples": [
        "example"
      ],
      "title": "Config Hash",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "cost_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the cost value reads as: '1 - nse_log' for an efficiency, 'log10(rmse)' for a transformed block",
      "title": "Cost Label",
      "x-hmp-profile": "user"
    },
    "cost_name": {
      "description": "Name of the cost the search minimised",
      "examples": [
        "example"
      ],
      "title": "Cost Name",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "End of the session, UTC",
      "title": "Ended At",
      "x-hmp-profile": "user"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why a failed session failed",
      "title": "Error Message",
      "x-hmp-profile": "user"
    },
    "hydromodpy_version": {
      "description": "Version that ran the session",
      "examples": [
        "example"
      ],
      "title": "Hydromodpy Version",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "method": {
      "description": "Search method",
      "examples": [
        "example"
      ],
      "title": "Method",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "protocol": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionProtocol"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The protocol the session follows; none when it names no protocol",
      "x-hmp-profile": "user"
    },
    "root_search": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bracket or roots a root search closed with",
      "title": "Root Search",
      "x-hmp-profile": "user"
    },
    "schema": {
      "default": "hydromodpy.session.v4",
      "description": "Schema id",
      "title": "Schema",
      "type": "string"
    },
    "scored": {
      "description": "The pairs the cost of the best trial was scored on; empty when none counted",
      "items": {
        "$ref": "#/$defs/ScoredSamples"
      },
      "title": "Scored",
      "type": "array",
      "x-hmp-profile": "user"
    },
    "session_id": {
      "description": "Id of the session",
      "examples": [
        "example"
      ],
      "title": "Session Id",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "sites": {
      "description": "Sites of the cases, sorted",
      "items": {
        "type": "string"
      },
      "title": "Sites",
      "type": "array",
      "x-hmp-profile": "user"
    },
    "started_at": {
      "description": "Start of the session, UTC",
      "format": "date-time",
      "title": "Started At",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "status": {
      "default": "running",
      "examples": [
        "running"
      ],
      "title": "Status",
      "type": "string",
      "x-hmp-profile": "user",
      "x-hmp-vocabulary": [
        "running",
        "completed",
        "partial",
        "aborted",
        "failed"
      ]
    },
    "stop_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The phases that froze the best of a budget-only search, in words; none when no phase did",
      "title": "Stop Note",
