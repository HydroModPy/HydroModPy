{
  "$defs": {
    "BestTrial": {
      "additionalProperties": false,
      "description": "The trial a session or a phase holds as its best.",
      "properties": {
        "objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Objective value of the trial",
          "title": "Objective",
          "x-hmp-profile": "user"
        },
        "rel_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Directory of that run, a hint",
          "title": "Rel Dir",
          "x-hmp-profile": "user"
        },
        "sim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run of the promoted trial",
          "title": "Sim Id",
          "x-hmp-profile": "user"
        },
        "trial": {
          "description": "Trial number, unique in the session",
          "examples": [
            1
          ],
          "minimum": 1,
          "title": "Trial",
          "type": "integer",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "trial"
      ],
      "title": "BestTrial",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "description": "A closed range of days, ``start`` and ``end`` included.",
      "properties": {
        "end": {
          "description": "Last day of the window, included",
          "format": "date",
          "title": "End",
          "type": "string",
          "x-hmp-profile": "user"
        },
        "start": {
          "description": "First day of the window",
          "format": "date",
          "title": "Start",
          "type": "string",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "ScoredSamples": {
      "additionalProperties": false,
      "description": "The pairs one dated output's cost was scored on.\n\nA stamp closes its period, so ``first`` and ``last`` are the ends of the\nfirst and last period scored, not the bounds of a window.",
      "properties": {
        "first": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First period-end stamp scored",
          "title": "First",
          "x-hmp-profile": "user"
        },
        "last": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last period-end stamp scored",
          "title": "Last",
          "x-hmp-profile": "user"
        },
        "n": {
          "description": "Number of paired samples scored",
          "examples": [
            1
          ],
          "minimum": 0,
          "title": "N",
          "type": "integer",
          "x-hmp-profile": "user"
        }
      },
      "required": [
        "n"
      ],
      "title": "ScoredSamples",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Identity, search and outcome of one calibration session.",
  "properties": {
    "best": {
      "anyOf": [
        {
          "$ref": "#/$defs/BestTrial"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Best trial so far",
      "x-hmp-profile": "user"
    },
    "case_id": {
      "description": "Case the session calibrates",
      "examples": [
        "example"
      ],
      "title": "Case Id",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "config_hash": {
      "description": "Identity hash of the resolved case configuration",
      "examples": [
        "example"
      ],
      "title": "Config Hash",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "End of the session, UTC",
      "title": "Ended At",
      "x-hmp-profile": "user"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why a failed session failed",
      "title": "Error Message",
      "x-hmp-profile": "user"
    },
    "hydromodpy_version": {
      "description": "Version that ran the session",
      "examples": [
        "example"
      ],
      "title": "Hydromodpy Version",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "method": {
      "description": "Search method",
      "examples": [
        "example"
      ],
      "title": "Method",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "objective_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the objective value is, read as a cost: '1 - nse_log' for an efficiency, 'log10(rmse)' for a transformed block",
      "title": "Objective Label",
      "x-hmp-profile": "user"
    },
    "objective_name": {
      "description": "Objective the search minimised",
      "examples": [
        "example"
      ],
      "title": "Objective Name",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "objective_samples": {
      "additionalProperties": {
        "$ref": "#/$defs/ScoredSamples"
      },
      "description": "Per dated output, the pairs the cost of the best trial was scored on; empty when no pair was counted",
      "title": "Objective Samples",
      "type": "object",
      "x-hmp-profile": "user"
    },
    "objective_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Window the objective was scored on, as declared, a bound left open closed by the dates of [simulation.time]",
      "x-hmp-profile": "user"
    },
    "root_search": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bracket or roots a root search closed with",
      "title": "Root Search",
      "x-hmp-profile": "user"
    },
    "schema": {
      "default": "hydromodpy.session.v3",
      "description": "Schema id",
      "title": "Schema",
      "type": "string"
    },
    "search_space": {
      "additionalProperties": true,
      "description": "Parameter to bounds",
      "title": "Search Space",
      "type": "object",
      "x-hmp-profile": "user"
    },
    "session_id": {
      "description": "Id of the session",
      "examples": [
        "example"
      ],
      "title": "Session Id",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "site": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Site of the case",
      "title": "Site",
      "x-hmp-profile": "user"
    },
    "started_at": {
      "description": "Start of the session, UTC",
      "format": "date-time",
      "title": "Started At",
      "type": "string",
      "x-hmp-profile": "user"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "completed",
        "partial",
        "aborted",
        "failed"
      ],
      "examples": [
        "running"
      ],
      "title": "Status",
      "type": "string",
      "x-hmp-profile": "user"
    }
  },
  "required": [
    "session_id",
    "case_id",
    "config_hash",
    "hydromodpy_version",
    "method",
    "objective_name",
    "started_at"
  ],
  "title": "SessionDescriptor",
  "type": "object"
}
