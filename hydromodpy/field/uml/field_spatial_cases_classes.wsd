@startuml
title Field Spatial Classes - Parent + Square + Geology

package "hydromodpy.field.core.field_spatial" {
  abstract class Field {
    +identifier: str
    +on_mesh(mesh, cell_samples_per_axis=10)
    +from_dict(config)
    +from_toml(toml_path, section)
  }

  abstract class FieldDiscretization {
    +mesh: BaseFieldMesh
    +field_id: str
    +aggregation_name()
    +weighted_components()
  }
}

package "hydromodpy.field.core.field_spatial_weighted_discretization" {
  class WeightedAverageFieldDiscretization {
    +zone_keys: tuple[str, ...]
    +fractions_by_zone: dict[str, np.ndarray]
    +aggregation_name()
    +weighted_components()
  }
}

package "hydromodpy.field.core.field_mesh" {
  abstract class BaseFieldMesh {
    +n_cells
    +cells
    +to_cell_values(values)
    +attach_cell_values(values, label=None)
  }
}

package "hydromodpy.field.cases.square.field_spatial_square" {
  class FieldSquare {
    +line: str
    +zone1_side: str
    +zone1_name: str
    +zone2_name: str
    +zone_id(x, y)
    +on_mesh(mesh, cell_samples_per_axis=10)
  }
}

package "hydromodpy.data_managers.geology.geology_field" {
  class GeologyField {
    +encoded_codes: np.ndarray
    +encoded_to_zone: dict[int, str]
    +transform
    +zone_id(x, y)
    +on_mesh(mesh, cell_samples_per_axis=10)
  }
}

package "hydromodpy.data_managers.geology.geology_mesh" {
  class GeologyStructuredMesh {
    +from_bounds(bounds, target_n_cells=400)
  }
}

Field <|-- FieldSquare
Field <|-- GeologyField

FieldDiscretization <|-- WeightedAverageFieldDiscretization
WeightedAverageFieldDiscretization --> BaseFieldMesh

FieldSquare --> WeightedAverageFieldDiscretization : on_mesh(...)
GeologyField --> WeightedAverageFieldDiscretization : on_mesh(...)

BaseFieldMesh <|-- GeologyStructuredMesh
GeologyField ..> GeologyStructuredMesh : projected on

@enduml
