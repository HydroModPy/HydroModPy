*.sh text eol=lf

# hydromodpy/examples/catalog.toml records the size and sha256 of these files
# as the repository serves them. A CRLF checkout on Windows would hash other bytes.
examples/** text=auto eol=lf

# tests/regression/frozen_runs/ is compared by digest with what a run stored.
# A CRLF checkout on Windows would hash other bytes.
tests/regression/frozen_runs/v*/** -text

# tests/regression/frozen_documents/ is compared by digest with what the generator wrote.
tests/regression/frozen_documents/v*/** -text
